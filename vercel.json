{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/portfolio-for-ai.js": {
      "maxDuration": 60
    },
    "api/historical-snapshot.js": {
      "maxDuration": 60
    },
    "api/backtest-batch.js": {
      "maxDuration": 60
    },
    "api/backtest-save.js": {
      "maxDuration": 60
    },
    "api/download-historical.js": {
      "maxDuration": 60
    },
    "api/sa-analyze.js": {
      "maxDuration": 300
    },
    "api/generate-analysis.js": {
      "maxDuration": 300
    },
    "api/cron-weekly.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron-weekly",
      "schedule": "0 2 * * 0"
    }
{ "path": "/api/cron-distributions", "schedule": "0 1 * * 0" }
  ]
}
